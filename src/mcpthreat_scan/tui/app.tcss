/* Autorea look (restrained green on dark). Colors come from the registered theme in
   tui/theme.py, never hard-coded here; this file only sets spacing, borders and layout. */

/* ---------- main menu ---------- */

#menu-body {
    width: 100%;
    max-width: 100;
    height: 1fr;
    padding: 0 1;
}

#brand {
    width: 100%;
    max-width: 100;
    height: auto;
    margin: 1 1 0 1;
}

#brand-mark {
    width: 9;
    height: 5;
}

#wordmark {
    width: 1fr;
    height: auto;
    text-wrap: nowrap;
}

#app-header {
    width: 1fr;
    height: 5;
    content-align: left middle;
}

.section-title {
    color: $text-muted;
    text-style: bold;
    margin: 1 0 0 0;
}

#workspace {
    height: auto;
    margin: 1 0 0 0;
    padding: 0 1;
    border: round $border;
    border-title-color: $text-muted;
    border-title-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#main-menu {
    height: auto;
    margin: 1 0 0 0;
    padding: 0;
    border: round $border;
    border-title-color: $text-muted;
    border-title-style: bold;
    background: transparent;
}

#main-menu:focus {
    border: round $accent;
    border-title-color: $accent;
}

#main-menu > .option-list--option {
    padding: 0 1;
}

#main-menu > .option-list--option-disabled {
    color: $text-muted;
}

#shortcuts {
    dock: bottom;
    height: 1;
    padding: 0 3;
    background: $surface;
    color: $text-muted;
}

/* ---------- shared widgets ---------- */

Header {
    background: $surface;
    color: $foreground;
}

Footer {
    background: $surface;
}

OptionList {
    border: round $border;
    margin: 1 2;
}

OptionList:focus {
    border: round $accent;
}

DataTable {
    margin: 1 2;
}

/* ---------- findings: list on top, detail panel below ---------- */

#filter-bar {
    height: 1;
    padding: 0 2;
    margin: 1 0 0 0;
}

#findings-list {
    margin: 1 2 0 2;
    height: 1fr;
    min-height: 4;
    background: transparent;
    border-top: solid $border;
}

.finding-row {
    height: 1;
    padding: 0 1;
}

.finding-row Static {
    width: 100%;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#finding-detail {
    height: auto;
    max-height: 55%;
    margin: 0 2 1 2;
    padding: 1 2;
    border-top: solid $border;
    background: $surface;
}

#detail {
    height: auto;
}

/* ---------- wizard steps, summary, comparison, trust, settings ---------- */

.step-title {
    padding: 1 2 0 2;
    color: $accent;
    text-style: bold;
}

#path-status {
    padding: 0 2;
    color: $text-muted;
}

#target-details {
    margin: 0 0 1 0;
    padding: 0 0 0 1;
    border-left: solid $border;
    height: auto;
}

#status, #progress, #cancel-note {
    padding: 0 2;
}

#progress {
    height: auto;
    margin: 1 0;
}

#cancel-note {
    color: $text-muted;
}

LoadingIndicator {
    height: 1;
    margin: 1 2;
    color: $accent;
}

#summary-body, #comparison-body, #settings-body, #trust-body {
    height: 1fr;
    padding: 1 2;
}

#summary-card, #comparison, #settings {
    height: auto;
    margin: 0 0 1 0;
    padding: 0 0 0 1;
    border-left: solid $border;
}

#summary-actions {
    margin: 1 0;
}

#trust-note {
    padding: 1 2;
    color: $text-muted;
}

.section-source {
    height: auto;
    padding: 0 0 0 0;
}

#trusted-table, #exclusions-table {
    margin: 0 0 1 0;
    height: auto;
    max-height: 12;
}

/* ---------- dialogs (confirm, export, exclusion form) ---------- */

ConfirmScreen, ExportScreen, IgnoreRuleScreen {
    align: center middle;
}

.dialog {
    width: 70%;
    max-width: 80;
    min-width: 36;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: round $border;
}

.dialog-title {
    margin: 0 0 1 0;
}

.dialog-detail, .dialog-hint {
    color: $text-muted;
    margin: 0 0 1 0;
}

.dialog-buttons {
    height: auto;
    margin: 1 0 0 0;
}

.dialog Input, .dialog Select {
    margin: 0 0 1 0;
}

.dialog OptionList {
    margin: 0 0 1 0;
    height: auto;
}

#summary, #hint, #setup, #options {
    padding: 1 2;
}

#summary {
    text-style: bold;
}

Button {
    margin: 0 2 1 2;
}

Input {
    margin: 0 2 1 2;
    border: tall $border;
}

Input:focus {
    border: tall $accent;
}
